# Gerado por `clios theme apply`. Não edite.
# Visualizador: barras finas, sem fundo, degradê do cinza ao acento.

[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 5

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo

[color]
background = '{{ c.bg | hex }}'
gradient = 1
gradient_color_1 = '{{ c.mute | hex }}'
gradient_color_2 = '{{ c.accent_dim | hex }}'
gradient_color_3 = '{{ c.accent | hex }}'
gradient_color_4 = '{{ c.accent | hex }}'
gradient_color_5 = '{{ c.fg | hex }}'

[smoothing]
noise_reduction = 77
monstercat = 0
waves = 0
