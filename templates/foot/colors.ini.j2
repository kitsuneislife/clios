# Gerado por `clios theme apply`. Não edite.
# foot >= 1.28 só aceita [colors-dark] e [colors-light]; escrevemos na do modo atual.

[main]
initial-color-theme={{ mode }}

[colors-{{ mode }}]
cursor={{ c.bg | bare }} {{ c.accent | bare }}
foreground={{ c.fg | bare }}
background={{ c.bg | bare }}
selection-foreground={{ c.fg | bare }}
selection-background={{ c.accent_soft | bare }}
urls={{ c.accent | bare }}
regular0={{ c.ansi[0] | bare }}
regular1={{ c.ansi[1] | bare }}
regular2={{ c.ansi[2] | bare }}
regular3={{ c.ansi[3] | bare }}
regular4={{ c.ansi[4] | bare }}
regular5={{ c.ansi[5] | bare }}
regular6={{ c.ansi[6] | bare }}
regular7={{ c.ansi[7] | bare }}
bright0={{ c.ansi[8] | bare }}
bright1={{ c.ansi[9] | bare }}
bright2={{ c.ansi[10] | bare }}
bright3={{ c.ansi[11] | bare }}
bright4={{ c.ansi[12] | bare }}
bright5={{ c.ansi[13] | bare }}
bright6={{ c.ansi[14] | bare }}
bright7={{ c.ansi[15] | bare }}
