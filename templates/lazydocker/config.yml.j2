# Gerado por `clios theme apply`. Não edite.
gui:
  border: rounded
  nerdFontsVersion: "3"
  showBottomLine: false
  theme:
    activeBorderColor:
      - "{{ c.accent | hex }}"
      - bold
    inactiveBorderColor:
      - "{{ c.line | hex }}"
    optionsTextColor:
      - "{{ c.mute | hex }}"
    selectedLineBgColor:
      - "{{ c.raised | hex }}"
    defaultFgColor:
      - "{{ c.fg | hex }}"
reportAnonymousStats: false
update:
  dockerRefreshInterval: 100ms
