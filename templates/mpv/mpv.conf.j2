# Gerado por `clios theme apply`. Não edite.
# mpv sem enfeite: janela limpa, OSD na mesma fonte e cores do resto.

profile=gpu-hq
vo=gpu-next
hwdec=auto-safe
keep-open=yes
force-window=no
border=no

osc=no
osd-bar=yes
osd-font="{{ font.mono }}"
osd-font-size=26
osd-color="{{ c.fg | hex }}"
osd-border-color="{{ c.bg | hex }}"
osd-border-size=2
osd-bar-align-y=0.92
osd-bar-w=40
osd-bar-h=0.8
osd-duration=1200
sub-font="{{ font.mono }}"
sub-color="{{ c.fg | hex }}"
sub-border-color="{{ c.bg | hex }}"
sub-border-size=2.4
background-color="{{ c.bg | hex }}"
