# Gerado por `clios theme apply`. Não edite.
[theme]
name = "clios"

[colors]
Base = "{{ c.fg | hex }}"
Title = "{{ c.accent | hex }}"
Guidance = "{{ c.mute | hex }}"
Important = "{{ c.accent | hex }}"
Annotation = "{{ c.dim | hex }}"
AlertInfo = "{{ c.green | hex }}"
AlertWarn = "{{ c.yellow | hex }}"
AlertError = "{{ c.red | hex }}"
